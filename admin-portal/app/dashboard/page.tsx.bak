// @ts-nocheck
"use client";
import { useEffect, useMemo, useState } from "react";
import { useRouter } from "next/navigation";
import { apiBase } from "@/lib/api";
import { getTenantSlugFromHost, withTenantHeaders } from "@/lib/tenant";
import { 
  BarChart3, Users, Package, TrendingUp, Building2, 
  ShoppingCart, Truck, CheckCircle2, Clock, 
  DollarSign, Activity, ArrowUpRight, ArrowDownRight 
} from "lucide-react";

type OrgSettings = {
  name?: string;
  plan?: string;
  status?: string;
  region?: string;
  timezone?: string;
};

type User = { role: string };
type Delivery = { status: string };

export default function OrgAdminDashboard() {
  const router = useRouter();
  const [authed, setAuthed] = useState(false);
  const [email, setEmail] = useState<string | null>(null);
  const [role, setRole] = useState<string | null>(null);

  const [org, setOrg] = useState<OrgSettings | null>(null);
  const [userStats, setUserStats] = useState<{ total: number; admins: number; managers: number; riders: number } | null>(null);
  const [deliveryStats, setDeliveryStats] = useState<{ total: number; delivered: number; assigned: number; pending: number } | null>(null);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<string | null>(null);

  const base = useMemo(() => apiBase(), []);

  useEffect(() => {
    // Check if on tenant subdomain
    try {
      const host = window.location.hostname;
      const slug = getTenantSlugFromHost(host);
      if (!slug) {
        const userRole = localStorage.getItem("dc_role");
        if (userRole === "SuperAdmin") {
          router.push("/superadmin");
          return;
        }
      }
    } catch {}

    // Check auth
    const token = localStorage.getItem("dc_access");
    const userEmail = localStorage.getItem("dc_email");
    const userRole = localStorage.getItem("dc_role");
    if (!token || !userEmail) {
      router.push("/login");
      return;
    }
    setAuthed(true);
    setEmail(userEmail);
    setRole(userRole);
  }, [router]);

  useEffect(() => {
    if (!authed) return;
    const fetchData = async () => {
      setLoading(true);
      setError(null);
      try {
        const token = localStorage.getItem("dc_access") || "";
        const h = withTenantHeaders({ headers: { Authorization: `Bearer ${token}` }, cache: "no-store" });

        const [orgRes, usersRes, deliveriesRes] = await Promise.all([
          fetch(`${base}v1/org/settings`, h),
          fetch(`${base}v1/org/users`, h),
          fetch(`${base}v1/org/deliveries`, h).catch(() => null),
        ]);

        if (orgRes.ok) {
          const o = await orgRes.json();
          setOrg(o);
        }
        if (usersRes.ok) {
          const users: User[] = await usersRes.json();
          const total = users.length;
          const admins = users.filter((u) => u.role === "admin" || u.role === "owner").length;
          const managers = users.filter((u) => u.role === "manager").length;
          const riders = users.filter((u) => u.role === "rider").length;
          setUserStats({ total, admins, managers, riders });
        }
        if (deliveriesRes && deliveriesRes.ok) {
          const deliveries: Delivery[] = await deliveriesRes.json();
          const total = deliveries.length;
          const delivered = deliveries.filter((d) => d.status === "delivered").length;
          const assigned = deliveries.filter((d) => d.status === "assigned").length;
          const pending = deliveries.filter((d) => d.status === "pending").length;
          setDeliveryStats({ total, delivered, assigned, pending });
        }
      } catch (err: any) {
        setError(err.message || "Failed to load dashboard data");
      } finally {
        setLoading(false);
      }
    };
    fetchData();
  }, [authed, base]);

  if (!authed) return <div className="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-50 flex items-center justify-center"><div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div></div>;

  return (

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {loading && (
          <div className="flex items-center justify-center py-12">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600"></div>
          </div>
        )}

        {error && (
          <div className="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg mb-6">
            <p className="text-red-700">{error}</p>
          </div>
        )}

        {/* Stats Grid */}
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
          {/* Total Users Card */}
          <div className="bg-white rounded-2xl shadow-lg border border-gray-100 p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div className="flex items-center justify-between mb-4">
              <div className="h-14 w-14 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center shadow-lg">
                <Users className="h-7 w-7 text-white" />
              </div>
              <div className="flex items-center text-green-600 text-sm font-medium">
                <ArrowUpRight className="h-4 w-4 mr-1" />
                12%
              </div>
            </div>
            <h3 className="text-gray-500 text-sm font-medium mb-1">Total Users</h3>
            <p className="text-3xl font-bold text-gray-900">{userStats?.total || 0}</p>
            <div className="mt-4 flex gap-2">
              <span className="text-xs text-gray-500">Admins: {userStats?.admins || 0}</span>
              <span className="text-xs text-gray-500">•</span>
              <span className="text-xs text-gray-500">Riders: {userStats?.riders || 0}</span>
            </div>
          </div>

          {/* Total Deliveries Card */}
          <div className="bg-white rounded-2xl shadow-lg border border-gray-100 p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div className="flex items-center justify-between mb-4">
              <div className="h-14 w-14 rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center shadow-lg">
                <Package className="h-7 w-7 text-white" />
              </div>
              <div className="flex items-center text-green-600 text-sm font-medium">
                <ArrowUpRight className="h-4 w-4 mr-1" />
                8%
              </div>
            </div>
            <h3 className="text-gray-500 text-sm font-medium mb-1">Total Orders</h3>
            <p className="text-3xl font-bold text-gray-900">{deliveryStats?.total || 0}</p>
            <div className="mt-4 flex gap-2">
              <span className="text-xs text-gray-500">This month</span>
            </div>
          </div>

          {/* Delivered Card */}
          <div className="bg-white rounded-2xl shadow-lg border border-gray-100 p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div className="flex items-center justify-between mb-4">
              <div className="h-14 w-14 rounded-xl bg-gradient-to-br from-green-500 to-green-600 flex items-center justify-center shadow-lg">
                <CheckCircle2 className="h-7 w-7 text-white" />
              </div>
              <div className="flex items-center text-green-600 text-sm font-medium">
                <ArrowUpRight className="h-4 w-4 mr-1" />
                15%
              </div>
            </div>
            <h3 className="text-gray-500 text-sm font-medium mb-1">Delivered</h3>
            <p className="text-3xl font-bold text-gray-900">{deliveryStats?.delivered || 0}</p>
            <div className="mt-4">
              <div className="w-full bg-gray-200 rounded-full h-2">
                <div 
                  className="bg-gradient-to-r from-green-500 to-green-600 h-2 rounded-full transition-all duration-500"
                  style={{ width: `${deliveryStats?.total ? (deliveryStats.delivered / deliveryStats.total) * 100 : 0}%` }}
                ></div>
              </div>
            </div>
          </div>

          {/* Pending Card */}
          <div className="bg-white rounded-2xl shadow-lg border border-gray-100 p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div className="flex items-center justify-between mb-4">
              <div className="h-14 w-14 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center shadow-lg">
                <Clock className="h-7 w-7 text-white" />
              </div>
              <div className="flex items-center text-amber-600 text-sm font-medium">
                <ArrowDownRight className="h-4 w-4 mr-1" />
                3%
              </div>
            </div>
            <h3 className="text-gray-500 text-sm font-medium mb-1">Pending</h3>
            <p className="text-3xl font-bold text-gray-900">{deliveryStats?.pending || 0}</p>
            <div className="mt-4">
              <span className="text-xs text-gray-500">Awaiting assignment</span>
            </div>
          </div>
        </div>

        {/* Organization Info Card */}
        {org && (
          <div className="bg-white rounded-2xl shadow-lg border border-gray-100 p-8 mb-8">
            <div className="flex items-center gap-3 mb-6">
              <div className="h-12 w-12 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-600 flex items-center justify-center">
                <Building2 className="h-6 w-6 text-white" />
              </div>
              <div>
                <h2 className="text-2xl font-bold text-gray-900">{org.name}</h2>
                <p className="text-sm text-gray-500">Organization Details</p>
              </div>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div className="bg-gradient-to-br from-blue-50 to-indigo-50 rounded-xl p-4">
                <p className="text-sm font-medium text-gray-600 mb-1">Plan</p>
                <p className="text-lg font-semibold text-gray-900">{org.plan || "Free"}</p>
              </div>
              <div className="bg-gradient-to-br from-green-50 to-emerald-50 rounded-xl p-4">
                <p className="text-sm font-medium text-gray-600 mb-1">Status</p>
                <p className="text-lg font-semibold text-gray-900">{org.status || "Active"}</p>
              </div>
              <div className="bg-gradient-to-br from-purple-50 to-pink-50 rounded-xl p-4">
                <p className="text-sm font-medium text-gray-600 mb-1">Region</p>
                <p className="text-lg font-semibold text-gray-900">{org.region || "Global"}</p>
              </div>
            </div>
          </div>
        )}

        {/* Quick Actions */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
          <a href="/orders" className="group bg-white rounded-2xl shadow-lg border border-gray-100 p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div className="flex items-center justify-between mb-4">
              <div className="h-12 w-12 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center group-hover:scale-110 transition-transform">
                <ShoppingCart className="h-6 w-6 text-white" />
              </div>
              <ArrowUpRight className="h-5 w-5 text-gray-400 group-hover:text-blue-600 transition-colors" />
            </div>
            <h3 className="text-lg font-semibold text-gray-900 mb-1">Manage Orders</h3>
            <p className="text-sm text-gray-500">View and manage all orders</p>
          </a>

          <a href="/customers" className="group bg-white rounded-2xl shadow-lg border border-gray-100 p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div className="flex items-center justify-between mb-4">
              <div className="h-12 w-12 rounded-xl bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center group-hover:scale-110 transition-transform">
                <Users className="h-6 w-6 text-white" />
              </div>
              <ArrowUpRight className="h-5 w-5 text-gray-400 group-hover:text-purple-600 transition-colors" />
            </div>
            <h3 className="text-lg font-semibold text-gray-900 mb-1">Customers</h3>
            <p className="text-sm text-gray-500">Manage customer data</p>
          </a>

          <a href="/settings" className="group bg-white rounded-2xl shadow-lg border border-gray-100 p-6 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
            <div className="flex items-center justify-between mb-4">
              <div className="h-12 w-12 rounded-xl bg-gradient-to-br from-indigo-500 to-indigo-600 flex items-center justify-center group-hover:scale-110 transition-transform">
                <Activity className="h-6 w-6 text-white" />
              </div>
              <ArrowUpRight className="h-5 w-5 text-gray-400 group-hover:text-indigo-600 transition-colors" />
            </div>
            <h3 className="text-lg font-semibold text-gray-900 mb-1">Settings</h3>
            <p className="text-sm text-gray-500">Configure your account</p>
          </a>
        </div>
      </div>
    </div>
  );
}
