# /etc/systemd/system/digitalchain-backend.service
[Unit]
Description=Digitalchain FastAPI (Uvicorn)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/digitalchain/backend
EnvironmentFile=/etc/digitalchain/backend.env
ExecStart=/usr/bin/env uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --app-dir /opt/digitalchain/backend
Restart=always
RestartSec=5
# Hardening (adjust as needed)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
