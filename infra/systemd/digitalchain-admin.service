# /etc/systemd/system/digitalchain-admin.service
[Unit]
Description=Digitalchain Admin Portal (Next.js)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/digitalchain/admin-portal
Environment=NODE_ENV=production
EnvironmentFile=/etc/digitalchain/admin.env
ExecStart=/usr/bin/env npm run start --silent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
