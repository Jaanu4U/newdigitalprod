# Nginx HTTPS reverse proxy for Digitalchain API
# Place under /etc/nginx/sites-available/api.digitalchain.in and symlink to sites-enabled
# Ensure you have valid LetsEncrypt certs for api.digitalchain.in

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.digitalchain.in;

    ssl_certificate /etc/letsencrypt/live/api.digitalchain.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.digitalchain.in/privkey.pem;

    # Allow large JSON bodies if needed
    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
